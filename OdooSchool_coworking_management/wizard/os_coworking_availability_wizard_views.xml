<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="os_coworking_view_availability_wizard_form" model="ir.ui.view">
        <field name="name">os.coworking.availability.wizard.form</field>
        <field name="model">os.coworking.availability.wizard</field>
        <field name="arch" type="xml">
            <form string="Find Available Resource">
                <group>
                    <group string="Resource Criteria">
                        <field
                            name="location_id"
                            options="{'no_create': True}"
                        />
                        <field name="resource_type"/>
                        <field name="capacity"/>
                        <field
                            name="partner_id"
                            options="{'no_create': True}"
                        />
                    </group>
                    <group string="Period">
                        <field name="start_datetime"/>
                        <field name="end_datetime"/>
                    </group>
                </group>
                <field name="search_performed" invisible="1"/>
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not search_performed or available_resource_ids"
                >
                    No available resources were found for the selected criteria.
                    Matching resources may not exist, may not meet the minimum
                    capacity, may be inactive, archived, under maintenance, or
                    already booked for the selected period.
                </div>
                <group string="Search Results" invisible="not available_resource_ids">
                    <field
                        name="available_resource_ids"
                        widget="many2many_tags"
                        options="{'no_create': True}"
                    />
                    <field
                        name="selected_resource_id"
                        options="{'no_create': True}"
                    />
                </group>
                <footer>
                    <button
                        name="action_search_resources"
                        string="Search"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        name="action_create_booking"
                        string="Create Booking"
                        type="object"
                        class="btn-primary"
                        invisible="not selected_resource_id"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="os_coworking_action_availability_wizard" model="ir.actions.act_window">
        <field name="name">Find Available Resource</field>
        <field name="res_model">os.coworking.availability.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="os_coworking_view_availability_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_os_coworking_booking"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,form</field>
    </record>

    <menuitem
        id="os_coworking_menu_availability_wizard"
        name="Find Available Resource"
        parent="os_coworking_menu_operations"
        action="os_coworking_action_availability_wizard"
        sequence="30"
        groups="OdooSchool_coworking_management.group_coworking_user"
    />
</odoo>
