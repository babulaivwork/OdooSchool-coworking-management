<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="os_coworking_location_demo_central_hub" model="os.coworking.location">
        <field name="name">Central Hub</field>
        <field name="name@uk_UA">Центральний хаб</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="manager_id" ref="base.user_admin"/>
        <field name="staff_user_ids" eval="[Command.link(ref('base.user_admin')), Command.link(ref('base.user_demo')), Command.link(ref('os_coworking_user_demo'))]"/>
        <field name="street">12 Soborna Street</field>
        <field name="city">Lutsk</field>
        <field name="zip">43000</field>
        <field name="working_hour_from">8.0</field>
        <field name="working_hour_to">20.0</field>
        <field name="description">A central coworking location for individual work and team meetings.</field>
        <field name="description@uk_UA">Центральна локація коворкінгу для індивідуальної роботи та командних зустрічей.</field>
    </record>

    <record id="os_coworking_location_demo_riverside" model="os.coworking.location">
