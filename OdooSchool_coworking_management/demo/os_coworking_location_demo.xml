        <field name="working_hour_from">9.0</field>
        <field name="working_hour_to">19.0</field>
        <field name="description">A quiet workspace near the river with flexible working hours.</field>
        <field name="description@uk_UA">Тихий робочий простір біля річки з гнучким графіком роботи.</field>
    </record>

