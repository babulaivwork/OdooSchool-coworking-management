        <field name="plan_id" ref="os_coworking_membership_plan_demo_unlimited_month"/>
        <field name="date_start" eval="(DateTime.now() - timedelta(days=5)).strftime('%Y-%m-%d')"/>
        <field name="date_end" eval="(DateTime.now() + timedelta(days=24)).strftime('%Y-%m-%d')"/>
        <field name="state">active</field>
        <field name="auto_renew" eval="True"/>
