<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="os_coworking_membership_plan_demo_unlimited_day" model="os.coworking.membership.plan">
        <field name="name">Unlimited Day Pass</field>
        <field name="name@uk_UA">Безлімітний денний абонемент</field>
        <field name="usage_type">unlimited</field>
        <field name="duration_days">1</field>
        <field name="description">Unlimited coworking access for one day without automatic renewal.</field>
        <field name="description@uk_UA">Безлімітний доступ до коворкінгу на один день без автоматичного продовження.</field>
    </record>

    <record id="os_coworking_membership_plan_demo_unlimited_month" model="os.coworking.membership.plan">
        <field name="name">Unlimited Monthly</field>
        <field name="name@uk_UA">Місячний безліміт</field>
        <field name="usage_type">unlimited</field>
        <field name="duration_days">30</field>
        <field name="allow_auto_renew" eval="True"/>
        <field name="description">Unlimited access to all coworking locations for thirty days.</field>
        <field name="description@uk_UA">Безлімітний доступ до всіх локацій коворкінгу протягом тридцяти днів.</field>
    </record>

    <record id="os_coworking_membership_plan_demo_unlimited_quarter" model="os.coworking.membership.plan">
        <field name="name">Unlimited Quarterly</field>
        <field name="name@uk_UA">Квартальний безліміт</field>
        <field name="usage_type">unlimited</field>
        <field name="duration_days">90</field>
        <field name="all_locations" eval="False"/>
        <field name="allow_auto_renew" eval="True"/>
        <field name="description">Unlimited access for ninety days within one selected location.</field>
        <field name="description@uk_UA">Безлімітний доступ протягом дев'яноста днів у межах однієї вибраної локації.</field>
    </record>

    <record id="os_coworking_membership_plan_demo_hours_starter" model="os.coworking.membership.plan">
        <field name="name">Starter 10 Hours</field>
        <field name="name@uk_UA">Стартові 10 годин</field>
        <field name="usage_type">hours</field>
        <field name="duration_days">30</field>
        <field name="included_hours">10.0</field>
        <field name="description">Ten coworking hours available during a thirty-day period.</field>
        <field name="description@uk_UA">Десять годин коворкінгу, доступних протягом тридцяти днів.</field>
    </record>

    <record id="os_coworking_membership_plan_demo_hours_professional" model="os.coworking.membership.plan">
        <field name="name">Professional 40 Hours</field>
        <field name="name@uk_UA">Професійні 40 годин</field>
        <field name="usage_type">hours</field>
        <field name="duration_days">30</field>
        <field name="included_hours">40.0</field>
        <field name="allow_auto_renew" eval="True"/>
        <field name="description">Forty flexible coworking hours with optional monthly renewal.</field>
        <field name="description@uk_UA">Сорок гнучких годин коворкінгу з можливістю щомісячного продовження.</field>
    </record>

    <record id="os_coworking_membership_plan_demo_hours_team" model="os.coworking.membership.plan">
        <field name="name">Team 100 Hours</field>
        <field name="name@uk_UA">Командні 100 годин</field>
        <field name="usage_type">hours</field>
        <field name="duration_days">90</field>
        <field name="included_hours">100.0</field>
        <field name="all_locations" eval="False"/>
        <field name="allow_auto_renew" eval="True"/>
        <field name="description">One hundred hours for use at one selected location during ninety days.</field>
        <field name="description@uk_UA">Сто годин для використання в одній вибраній локації протягом дев'яноста днів.</field>
    </record>

    <record id="os_coworking_membership_plan_demo_visits_flex" model="os.coworking.membership.plan">
        <field name="name">Flex 5 Visits</field>
        <field name="name@uk_UA">Гнучкі 5 відвідувань</field>
        <field name="usage_type">visits</field>
        <field name="duration_days">30</field>
        <field name="included_visits">5</field>
        <field name="description">Five coworking visits available within thirty days.</field>
        <field name="description@uk_UA">П'ять відвідувань коворкінгу, доступних протягом тридцяти днів.</field>
    </record>

    <record id="os_coworking_membership_plan_demo_visits_regular" model="os.coworking.membership.plan">
        <field name="name">Regular 12 Visits</field>
        <field name="name@uk_UA">Регулярні 12 відвідувань</field>
        <field name="usage_type">visits</field>
        <field name="duration_days">60</field>
        <field name="included_visits">12</field>
        <field name="allow_auto_renew" eval="True"/>
        <field name="description">Twelve visits across all locations during a sixty-day period.</field>
        <field name="description@uk_UA">Дванадцять відвідувань усіх локацій протягом шістдесяти днів.</field>
    </record>

    <record id="os_coworking_membership_plan_demo_visits_community" model="os.coworking.membership.plan">
        <field name="name">Community 30 Visits</field>
        <field name="name@uk_UA">30 відвідувань для спільноти</field>
        <field name="usage_type">visits</field>
        <field name="duration_days">90</field>
        <field name="included_visits">30</field>
        <field name="all_locations" eval="False"/>
        <field name="allow_auto_renew" eval="True"/>
        <field name="description">Thirty visits at one selected location during ninety days.</field>
        <field name="description@uk_UA">Тридцять відвідувань однієї вибраної локації протягом дев'яноста днів.</field>
    </record>

    <record id="os_coworking_membership_plan_demo_archived_unlimited" model="os.coworking.membership.plan">
        <field name="name">Legacy Unlimited Monthly</field>
        <field name="name@uk_UA">Архівний місячний безліміт</field>
        <field name="usage_type">unlimited</field>
        <field name="duration_days">30</field>
        <field name="description">A discontinued unlimited monthly plan retained for historical records.</field>
        <field name="description@uk_UA">Закритий місячний безлімітний тариф, збережений для історичних записів.</field>
        <field name="active" eval="False"/>
    </record>

    <record id="os_coworking_membership_plan_demo_archived_hours" model="os.coworking.membership.plan">
        <field name="name">Legacy 20 Hours</field>
        <field name="name@uk_UA">Архівні 20 годин</field>
        <field name="usage_type">hours</field>
        <field name="duration_days">60</field>
        <field name="included_hours">20.0</field>
        <field name="description">A discontinued twenty-hour plan retained for historical records.</field>
        <field name="description@uk_UA">Закритий тариф на двадцять годин, збережений для історичних записів.</field>
        <field name="active" eval="False"/>
    </record>

    <record id="os_coworking_membership_plan_demo_archived_visits" model="os.coworking.membership.plan">
        <field name="name">Legacy 8 Visits</field>
        <field name="name@uk_UA">Архівні 8 відвідувань</field>
        <field name="usage_type">visits</field>
        <field name="duration_days">45</field>
        <field name="included_visits">8</field>
        <field name="description">A discontinued eight-visit plan retained for historical records.</field>
        <field name="description@uk_UA">Закритий тариф на вісім відвідувань, збережений для історичних записів.</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
