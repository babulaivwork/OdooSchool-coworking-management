<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="os_coworking_view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.coworking</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_coworking_memberships"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-id-card"
                    invisible="not is_coworking_client"
                    groups="OdooSchool_coworking_management.group_coworking_user"
                >
                    <field
                        name="coworking_membership_count"
                        string="Memberships"
                        widget="statinfo"
                    />
                </button>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page
                    name="coworking"
                    string="Coworking"
                    groups="OdooSchool_coworking_management.group_coworking_user"
                >
                    <group>
                        <field name="is_coworking_client"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="os_coworking_action_client" model="ir.actions.act_window">
        <field name="name">Coworking Clients</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_coworking_client', '=', True)]</field>
        <field name="context">{'default_is_coworking_client': True}</field>
    </record>

    <menuitem
        id="os_coworking_menu_client"
        name="Clients"
        parent="os_coworking_menu_root"
        action="os_coworking_action_client"
        sequence="10"
        groups="OdooSchool_coworking_management.group_coworking_user"
    />
</odoo>
