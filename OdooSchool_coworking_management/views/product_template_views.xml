<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="os_coworking_view_product_template_form" model="ir.ui.view">
        <field name="name">product.template.form.coworking</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page
                    name="coworking"
                    string="Coworking"
                    groups="OdooSchool_coworking_management.group_coworking_user"
                >
                    <group>
                        <field name="is_coworking_service"/>
                        <field
                            name="coworking_service_type"
                            invisible="not is_coworking_service"
                            required="is_coworking_service"
                        />
                        <field
                            name="coworking_plan_ids"
                            widget="many2many_tags"
                            invisible="not is_coworking_service or coworking_service_type != 'membership'"
                            options="{'no_create': True}"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="os_coworking_action_service" model="ir.actions.act_window">
        <field name="name">Coworking Services</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_coworking_service', '=', True)]</field>
        <field name="context">
            {
                'default_is_coworking_service': True,
                'default_type': 'service',
            }
        </field>
    </record>

    <menuitem
        id="os_coworking_menu_service"
        name="Services"
        parent="os_coworking_menu_root"
        action="os_coworking_action_service"
        sequence="40"
        groups="OdooSchool_coworking_management.group_coworking_user"
    />
</odoo>
