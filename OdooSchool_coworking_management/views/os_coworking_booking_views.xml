<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="os_coworking_view_booking_list" model="ir.ui.view">
        <field name="name">os.coworking.booking.list</field>
        <field name="model">os.coworking.booking</field>
        <field name="arch" type="xml">
            <list
                decoration-success="state == 'confirmed'"
                decoration-muted="state in ['done', 'cancelled']"
            >
                <field name="name"/>
                <field name="partner_id"/>
                <field name="membership_id" optional="show"/>
                <field name="location_id"/>
                <field name="resource_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="duration_hours" optional="show"/>
                <field name="reserved_hours" optional="hide"/>
                <field name="reserved_visits" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="os_coworking_view_booking_form" model="ir.ui.view">
        <field name="name">os.coworking.booking.form</field>
        <field name="model">os.coworking.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state != 'confirmed'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,done,cancelled"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Booking">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field
                                name="membership_id"
                                readonly="state != 'draft'"
                                domain="[('partner_id', '=', partner_id), ('state', '=', 'active')]"
                                options="{'no_create': True}"
                            />
                            <field
                                name="resource_id"
                                readonly="state != 'draft'"
                                domain="[('active', '=', True), ('state', '=', 'available')]"
                                options="{'no_create': True}"
                            />
                            <field name="location_id"/>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group string="Schedule">
                            <field name="start_datetime" readonly="state != 'draft'"/>
                            <field name="end_datetime" readonly="state != 'draft'"/>
                            <field name="duration_hours"/>
                        </group>
                    </group>
                    <group string="Reserved Membership Limit" invisible="state == 'draft'">
                        <group>
                            <field name="reserved_hours"/>
                        </group>
                        <group>
                            <field name="reserved_visits"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="os_coworking_view_booking_search" model="ir.ui.view">
        <field name="name">os.coworking.booking.search</field>
        <field name="model">os.coworking.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="membership_id"/>
                <field name="location_id"/>
                <field name="resource_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="start_datetime" string="Start" date="start_datetime"/>
                <filter name="end_datetime" string="End" date="end_datetime"/>
                <group>
                    <filter name="group_by_location" string="Location" context="{'group_by': 'location_id'}"/>
                    <filter name="group_by_resource" string="Resource" context="{'group_by': 'resource_id'}"/>
                    <filter name="group_by_client" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter
                        name="group_by_start_month"
                        string="Start Month"
                        context="{'group_by': 'start_datetime:month'}"
                    />
                </group>
                <searchpanel>
                    <field
                        name="location_id"
                        string="Locations"
                        select="multi"
                        enable_counters="1"
                    />
                    <field
                        name="resource_id"
                        string="Resources"
                        select="multi"
                        enable_counters="1"
                    />
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="os_coworking_view_booking_graph" model="ir.ui.view">
        <field name="name">os.coworking.booking.graph</field>
        <field name="model">os.coworking.booking</field>
        <field name="arch" type="xml">
            <graph string="Booking Analysis" type="bar" stacked="1">
                <field name="start_datetime" interval="month" type="row"/>
                <field name="state" type="col"/>
                <field name="duration_hours" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="os_coworking_view_booking_pivot" model="ir.ui.view">
        <field name="name">os.coworking.booking.pivot</field>
        <field name="model">os.coworking.booking</field>
        <field name="arch" type="xml">
            <pivot string="Booking Analysis" display_quantity="1">
                <field name="location_id" type="row"/>
                <field name="resource_id" type="row"/>
                <field name="start_datetime" interval="month" type="col"/>
                <field name="state" type="col"/>
                <field name="duration_hours" type="measure"/>
                <field name="reserved_hours" type="measure"/>
                <field name="reserved_visits" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="os_coworking_action_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">os.coworking.booking</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="os_coworking_view_booking_search"/>
    </record>

    <menuitem
        id="os_coworking_menu_operations"
        name="Operations"
        parent="os_coworking_menu_root"
        sequence="10"
        groups="OdooSchool_coworking_management.group_coworking_user"
    />

    <menuitem
        id="os_coworking_menu_booking"
        name="Bookings"
        parent="os_coworking_menu_operations"
        action="os_coworking_action_booking"
        sequence="10"
        groups="OdooSchool_coworking_management.group_coworking_user"
    />
</odoo>
