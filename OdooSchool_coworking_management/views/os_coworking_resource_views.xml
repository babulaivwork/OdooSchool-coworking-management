<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="os_coworking_view_resource_list" model="ir.ui.view">
        <field name="name">os.coworking.resource.list</field>
        <field name="model">os.coworking.resource</field>
        <field name="arch" type="xml">
            <list
                decoration-success="state == 'available'"
                decoration-warning="state == 'maintenance'"
                decoration-danger="state == 'inactive'"
            >
                <field name="name"/>
                <field name="code"/>
                <field name="location_id"/>
                <field name="resource_type"/>
                <field name="capacity"/>
                <field name="hourly_rate"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="os_coworking_view_resource_form" model="ir.ui.view">
        <field name="name">os.coworking.resource.form</field>
        <field name="model">os.coworking.resource</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="General Information">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="resource_type"/>
                            <field name="location_id"/>
                            <field name="company_id"/>
                            <field
                                name="active"
                                groups="OdooSchool_coworking_management.group_coworking_admin"
                            />
                        </group>
                        <group string="Resource Details">
                            <field name="capacity"/>
                            <field name="hourly_rate"/>
                            <field name="currency_id"/>
                            <field name="state"/>
                            <field name="image_1920" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="os_coworking_view_resource_search" model="ir.ui.view">
        <field name="name">os.coworking.resource.search</field>
        <field name="model">os.coworking.resource</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="name"
                    string="Resource or Location"
                    filter_domain="[
                        '|',
                        ('name', 'ilike', self),
                        ('location_id.name', 'ilike', self)
                    ]"
                />
                <field name="code"/>
                <field name="location_id"/>
                <field name="resource_type"/>
                <field name="state"/>
                <separator/>
                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="maintenance" string="Maintenance" domain="[('state', '=', 'maintenance')]"/>
                <filter name="inactive" string="Inactive" domain="[('state', '=', 'inactive')]"/>
                <separator/>
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                    groups="OdooSchool_coworking_management.group_coworking_admin"
                />
                <group>
                    <filter name="group_by_location" string="Location" context="{'group_by': 'location_id'}"/>
                    <filter name="group_by_type" string="Resource Type" context="{'group_by': 'resource_type'}"/>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="os_coworking_view_resource_kanban" model="ir.ui.view">
        <field name="name">os.coworking.resource.kanban</field>
        <field name="model">os.coworking.resource</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="false">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="d-flex align-items-center me-3">
                            <field
                                name="image_1920"
                                widget="image"
                                options="{'img_class': 'object-fit-cover'}"
                            />
                        </aside>
                        <main class="d-flex flex-column gap-1">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="code"/>
                            <div>
                                <span class="fw-bold">Location: </span>
                                <field name="location_id"/>
                            </div>
                            <div>
                                <field name="resource_type"/>
                                <span> · Capacity: </span>
                                <field name="capacity"/>
                            </div>
                            <footer class="mt-2">
                                <field name="hourly_rate"/>
                                <field name="state" class="ms-auto"/>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="os_coworking_action_resource" model="ir.actions.act_window">
        <field name="name">Resources</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">os.coworking.resource</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="os_coworking_view_resource_search"/>
    </record>

    <menuitem
        id="os_coworking_menu_resource"
        name="Resources"
        parent="os_coworking_menu_resources"
        action="os_coworking_action_resource"
        sequence="20"
        groups="OdooSchool_coworking_management.group_coworking_user"
    />
</odoo>
